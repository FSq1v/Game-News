---
import Base from "../layouts/Base.astro";
---

<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <section class="not-found container">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">ページが見つかりません</h1>
    <p class="not-found__lead">
      URL が変わったか、ページが削除された可能性があります。トップから最新のニュースとまとめ記事をたどれます。
    </p>
    <a class="not-found__home" href="/">トップへ戻る</a>
  </section>
</Base>

<style>
  .not-found {
    padding-block: var(--space-6);
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .not-found__code {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .not-found__title { font-size: var(--font-size-2xl); }
  .not-found__lead { max-width: var(--measure); color: var(--text-muted); }
  .not-found__home {
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-text);
    font-weight: 700;
    text-decoration: none;
  }
  .not-found__home:hover { text-decoration: underline; }
</style>
