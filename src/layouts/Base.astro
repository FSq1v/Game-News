---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** OGP 画像のパス。初期値は /og/site.png */
  ogImage?: string;
  /** まとめ記事のページで渡す。og:type を article にして、article:published_time に使う */
  article?: { publishedTime: string };
}

const { title, description = SITE_DESCRIPTION, ogImage = "/og/site.png", article } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// ビルドが実際に出す URL の形（directory 形式なのでトップ以外は末尾に / が付く）
const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImageUrl = new URL(ogImage, SITE_URL);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    {/* JS が動く印。絞り込みやタブは JS がないと動かないので、この印があるときだけ出す。
        描画の前に付けるので、あとから部品が出てきて画面がずれることはない */}
    <script is:inline>document.documentElement.setAttribute("data-js", "");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* 色は src/styles/tokens.css の --bg（ライト・ダーク）と同じ値 */}
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
