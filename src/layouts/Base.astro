---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** OGP 画像のパス。初期値は /og/site.png（画像は Task 8 で作る） */
  ogImage?: string;
  /** まとめ記事のページで渡す。OGP の article:published_time に使う（Task 8） */
  article?: { publishedTime: string };
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    {/* JS が動く印。絞り込みやタブは JS がないと動かないので、この印があるときだけ出す。
        描画の前に付けるので、あとから部品が出てきて画面がずれることはない */}
    <script is:inline>document.documentElement.setAttribute("data-js", "");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
