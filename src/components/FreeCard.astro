---
import type { Deal } from "../lib/news";
import { STORE_NAMES, formatEnd, formatShort, safeImageUrl, safeUrl, yen } from "../lib/format";

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const href = safeUrl(deal.link);
const image = safeImageUrl(deal.image);
const storeName = STORE_NAMES[deal.store] ?? deal.store;

let when = "";
if (deal.upcoming) {
  const start = deal.starts_at ? formatShort(deal.starts_at, "Asia/Tokyo") : "";
  when = start ? `${start}から配布予定` : "配布予定";
} else {
  const end = formatEnd(deal.ends_at, "Asia/Tokyo");
  when = end ? `${end}（通常 ${yen(deal.price_original)}）` : `通常 ${yen(deal.price_original)}`;
}
---

<li class:list={["free-card", { "is-upcoming": deal.upcoming }]} data-store={deal.store} data-search={deal.title.toLowerCase()}>
  <a class="free-card__link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="thumb">
      <span class="thumb__label" aria-hidden="true">{storeName}</span>
      {
        image !== "#" && (
          <img
            src={image}
            alt=""
            width="160"
            height="90"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
    </span>
    <span class="free-card__body">
      <span class="free-card__label">{deal.upcoming ? "来週の無料" : "いま無料"}</span>
      <span class="free-card__title">{deal.title}</span>
      <span class="free-card__when"><span class="free-card__store">{storeName}</span><span>{when}</span></span>
    </span>
  </a>
</li>

<style>
  .free-card[hidden] { display: none; }

  .free-card__link {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .free-card:not(.is-upcoming) .free-card__link {
    border-color: var(--genre, var(--accent));
    box-shadow: inset 4px 0 0 var(--genre, var(--accent));
  }

  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .thumb__label { color: var(--text-muted); font-size: var(--font-size-xs); font-weight: 700; }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb.is-missing img { display: none; }

  .free-card__body { display: grid; gap: 2px; min-width: 0; }
  .free-card__label {
    justify-self: start;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--genre, var(--accent));
    color: var(--on-genre);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.6;
  }
  .is-upcoming .free-card__label {
    background: var(--surface-2);
    color: var(--text);
  }
  .free-card__title {
    font-size: var(--font-size-sm);
    font-weight: 700;
    line-height: 1.45;
  }
  .free-card__store { color: var(--text); font-weight: 500; }
  .free-card__link:hover .free-card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .free-card__when {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
</style>
