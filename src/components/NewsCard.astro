---
import type { NewsItem } from "../lib/news";
import { formatShort, safeUrl } from "../lib/format";

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const href = safeUrl(item.link);
const image = item.image ? safeUrl(item.image) : "#";
// 検索はタイトル・原題・出典のどれかに当たればよい。改行でつなぐと、検索語（1 行）が語をまたいで当たらない
const search = [item.title, item.title_original, item.source]
  .filter(Boolean)
  .join("\n")
  .toLowerCase();
const original = item.translated && item.title_original ? `原題：${item.title_original}` : undefined;
---

<li class="news-card" data-id={item.id} data-region={item.region} data-search={search}>
  <a class="news-card__link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="thumb">
      <span class="thumb__label" aria-hidden="true">{item.source}</span>
      {
        image !== "#" && (
          <img
            src={image}
            alt=""
            width="160"
            height="90"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
    </span>
    <span class="news-card__body">
      <span class="news-card__title" title={original}>{item.title}</span>
      <span class="news-card__meta">
        <span class="news-card__source">{item.source}</span>
        <time datetime={item.published_at} data-rel>{formatShort(item.published_at, "Asia/Tokyo")}</time>
        {item.translated && <span class="badge" title={original}>翻訳</span>}
      </span>
    </span>
  </a>
  <button type="button" class="fav" aria-pressed="false" data-fav={item.id} data-fav-title={item.title}>
    <svg class="fav__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path d="M12 3.4l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.8l-5.2 2.8 1-5.9-4.3-4.1 5.9-.8z" />
    </svg>
    <span class="visually-hidden">{item.title}をお気に入りに追加</span>
  </button>
</li>

<style>
  .news-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--tap);
    align-items: start;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .news-card[hidden] { display: none; }

  .news-card__link {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .news-card__body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }
  .news-card__title {
    font-size: var(--font-size-base);
    font-weight: 600;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card__link:hover .news-card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .news-card__link:visited .news-card__title { color: var(--text-muted); }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }
  .news-card__source { color: var(--text); font-weight: 500; }
  .news-card time { font-variant-numeric: tabular-nums; }

  .badge {
    padding: 0 var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-xs);
    line-height: 1.6;
  }

  /* サムネイル：枠の比率を決めておき、画像がない・読めないときは出典名を見せる */
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .thumb__label {
    padding: var(--space-1) var(--space-2);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb.is-missing img { display: none; }

  .fav {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--duration) var(--ease), transform var(--duration) var(--ease);
  }
  :global(:root:not([data-js])) .fav { display: none; }
  .fav:hover { color: var(--text); background: var(--surface-2); }
  .fav__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .fav[aria-pressed="true"] { color: var(--genre, var(--accent)); }
  .fav[aria-pressed="true"] .fav__icon { fill: currentColor; }
  .fav:active { transform: scale(0.9); }

  @media (min-width: 600px) {
    .news-card__link { grid-template-columns: 176px minmax(0, 1fr); gap: var(--space-4); }
    .news-card__title { font-size: var(--font-size-md); line-height: 1.45; -webkit-line-clamp: 2; line-clamp: 2; }
    .news-card__meta { font-size: var(--font-size-sm); }
  }
</style>
