---
import type { Deal } from "../lib/news";
import { STORE_NAMES, formatEnd, safeImageUrl, safeUrl, yen } from "../lib/format";

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const href = safeUrl(deal.link);
const image = safeImageUrl(deal.image);
const storeName = STORE_NAMES[deal.store] ?? deal.store;
const endsMs = deal.ends_at ? new Date(deal.ends_at).getTime() : NaN;
const ends = formatEnd(deal.ends_at, "Asia/Tokyo");
---

<li
  class="deal"
  data-store={deal.store}
  data-discount={deal.discount}
  data-price={deal.price_sale}
  data-ends={Number.isNaN(endsMs) ? "" : endsMs}
  data-search={deal.title.toLowerCase()}
>
  <a class="deal__link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="thumb">
      <span class="thumb__label" aria-hidden="true">{storeName}</span>
      {
        image !== "#" && (
          <img
            src={image}
            alt=""
            width="160"
            height="75"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
    </span>
    <span class="deal__body">
      <span class="deal__title">{deal.title}</span>
      <span class="deal__meta">
        <span class="deal__store">{storeName}</span>
        {ends && <span>{ends}</span>}
      </span>
    </span>
    <span class="tag">
      <span class="tag__off"><span class="visually-hidden">割引率 </span>-{deal.discount}%</span>
      <span class="tag__price">{yen(deal.price_sale)}</span>
      <s class="tag__was"><span class="visually-hidden">通常価格 </span>{yen(deal.price_original)}</s>
    </span>
  </a>
</li>

<style>
  .deal { border-bottom: 1px solid var(--border); }
  .deal[hidden] { display: none; }

  .deal__link {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    min-height: var(--tap);
    padding-block: var(--space-3);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 32 / 15; /* Steam のヘッダー画像（460×215）に近い比率 */
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .thumb__label {
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.2;
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb.is-missing img { display: none; }

  .deal__body { display: grid; gap: 2px; min-width: 0; }
  .deal__title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .deal__link:hover .deal__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .deal__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .deal__store { color: var(--text); font-weight: 500; }

  .tag {
    display: grid;
    justify-items: end;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tag__off {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--genre-soft, var(--surface-2));
    color: var(--genre, var(--text));
    font-size: var(--font-size-xs);
    font-weight: 700;
  }
  .tag__price { font-size: var(--font-size-base); font-weight: 700; }
  .tag__was { color: var(--text-muted); font-size: var(--font-size-xs); }
</style>
