---
// 起動アニメーション。暗い画面に光の粒が漂い、中央に集まって Signal のロゴになり、そのまま消える。
// 出すかどうかは Base.astro の <head> の小さなスクリプトが描画前に決めて、<html data-splash> を付ける
// （タブを開いて最初の 1 回だけ。動きを減らす設定のときは出さない）。
import { SITE_NAME } from "../site";
---

<div class="splash" aria-hidden="true" data-splash-root>
  <canvas class="splash__canvas"></canvas>
  <p class="splash__name">{SITE_NAME}</p>
</div>

<script>
  // ロゴの形（viewBox 24×24 の座標。SiteHeader.astro の SVG と同じ）
  const DOT = { x: 6, y: 18, r: 2.6 };
  const ARCS = [
    { r: 7.5, color: "#ff7a5c" }, // 内側の弧：ゲームの色
    { r: 14.5, color: "#a594ff" }, // 外側の弧：AI の色
  ];
  const DOT_COLOR = "#f5f5f7";
  const STROKE = 2.6;
  // 形の外枠のまんなか。ここを画面の中心に合わせる
  const CENTER = { x: 12.6, y: 11.4 };

  const GATHER_START = 250; // 漂うのをやめて集まりはじめる時刻（ms）
  const GATHER_END = 1150; // 集まり終わる時刻
  const HOLD_END = 1900; // ロゴを見せ終わる時刻
  const FADE = 450; // 消えるまでの時間

  type Particle = {
    x: number; y: number; // いまの位置
    sx: number; sy: number; // 集まりはじめたときの位置
    tx: number; ty: number; // 行き先（ロゴの上の点）
    vx: number; vy: number; // 漂う速さ
    size: number;
    sprite: HTMLCanvasElement;
    delay: number; // 集まりはじめを少しずつずらす
  };

  const root = document.querySelector<HTMLElement>("[data-splash-root]");
  const html = document.documentElement;

  function finish(): void {
    html.removeAttribute("data-splash");
    root?.remove();
  }

  function start(root: HTMLElement): void {
    const canvas = root.querySelector("canvas");
    const name = root.querySelector<HTMLElement>(".splash__name");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !name || !ctx) return finish();

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = window.innerWidth;
    const h = window.innerHeight;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.scale(dpr, dpr);

    // ロゴの大きさと位置。下に名前を置くので、少し上に寄せる
    const unit = (Math.min(w, h, 520) * 0.36) / 24;
    const ox = w / 2 - CENTER.x * unit;
    const oy = h / 2 - CENTER.y * unit - unit * 3;
    const toScreen = (x: number, y: number) => ({ x: ox + x * unit, y: oy + y * unit });
    name.style.top = `${oy + 24 * unit}px`;

    // 光の粒の絵。色ごとに 1 枚だけ作って使い回す（粒ごとにぼかしを掛けると、スマホでは重い）
    const sprites = new Map<string, HTMLCanvasElement>();
    const sprite = (color: string) => {
      let s = sprites.get(color);
      if (s) return s;
      s = document.createElement("canvas");
      s.width = s.height = 32;
      const g = s.getContext("2d")!;
      const grad = g.createRadialGradient(16, 16, 0, 16, 16, 16);
      grad.addColorStop(0, "#ffffff");
      grad.addColorStop(0.12, color);
      grad.addColorStop(0.4, color + "99");
      grad.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = grad;
      g.fillRect(0, 0, 32, 32);
      sprites.set(color, s);
      return s;
    };

    // 行き先をロゴの上にばらまく。弧は長さに合わせて数を割り振る
    const total = w < 600 ? 150 : 230;
    const lengths = ARCS.map((a) => (a.r * Math.PI) / 2);
    const dotShare = 8;
    const sum = lengths.reduce((a, b) => a + b, 0) + dotShare;
    const targets: { x: number; y: number; color: string }[] = [];
    ARCS.forEach((arc, i) => {
      const n = Math.round((total * lengths[i]) / sum);
      for (let k = 0; k < n; k++) {
        // 上（-90°）から右（0°）まで。線の太さのぶんだけ内外にずらす
        const t = -Math.PI / 2 + (Math.PI / 2) * Math.random();
        const r = arc.r + (Math.random() - 0.5) * STROKE * 0.8;
        targets.push({ x: DOT.x + r * Math.cos(t), y: DOT.y + r * Math.sin(t), color: arc.color });
      }
    });
    while (targets.length < total) {
      const t = Math.random() * Math.PI * 2;
      const r = DOT.r * Math.sqrt(Math.random()) * 0.9;
      targets.push({ x: DOT.x + r * Math.cos(t), y: DOT.y + r * Math.sin(t), color: DOT_COLOR });
    }

    const particles: Particle[] = targets.map((t) => {
      const p = toScreen(t.x, t.y);
      const x = Math.random() * w;
      const y = Math.random() * h;
      return {
        x, y, sx: x, sy: y, tx: p.x, ty: p.y,
        vx: (Math.random() - 0.5) * 0.04,
        vy: (Math.random() - 0.5) * 0.04 - 0.015,
        size: unit * (1.1 + Math.random() * 1.3),
        sprite: sprite(t.color),
        delay: Math.random() * 220,
      };
    });

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    let begin = 0;
    let last = 0;
    let leaving = false;
    let raf = 0;

    const leave = () => {
      if (leaving) return;
      leaving = true;
      root.classList.add("is-leaving");
      window.setTimeout(() => {
        cancelAnimationFrame(raf);
        finish();
      }, FADE);
    };

    // 押す・キーを打つ・スクロールしようとしたら、すぐ消す
    for (const type of ["pointerdown", "keydown", "wheel", "touchmove"]) {
      window.addEventListener(type, leave, { once: true, passive: true });
    }

    const frame = (now: number) => {
      if (!begin) begin = last = now;
      const t = now - begin;
      const dt = Math.min(now - last, 50);
      last = now;

      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = "source-over";

      // ロゴの線。集まり終わるころに、粒の下から浮かび上がらせる
      const line = Math.min(Math.max((t - GATHER_END + 250) / 450, 0), 1);
      if (line > 0) {
        ctx.globalAlpha = line;
        ctx.lineCap = "round";
        ctx.lineWidth = STROKE * unit;
        ARCS.forEach((arc) => {
          ctx.strokeStyle = arc.color;
          ctx.beginPath();
          ctx.arc(ox + DOT.x * unit, oy + DOT.y * unit, arc.r * unit, -Math.PI / 2, 0);
          ctx.stroke();
        });
        ctx.fillStyle = DOT_COLOR;
        ctx.beginPath();
        ctx.arc(ox + DOT.x * unit, oy + DOT.y * unit, DOT.r * unit, 0, Math.PI * 2);
        ctx.fill();
      }

      // 粒は光が重なるように足し合わせる
      ctx.globalCompositeOperation = "lighter";
      for (const p of particles) {
        const g = (t - GATHER_START - p.delay) / (GATHER_END - GATHER_START - 220);
        if (g <= 0) {
          // 漂っているあいだ
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.sx = p.x;
          p.sy = p.y;
        } else {
          const e = easeInOut(Math.min(g, 1));
          p.x = p.sx + (p.tx - p.sx) * e;
          p.y = p.sy + (p.ty - p.sy) * e;
        }
        // 出てくるときはふわっと明るく、集まったあとは線に溶けるように少し暗く
        const appear = Math.min(t / 300, 1);
        const settle = 1 - line * 0.75;
        ctx.globalAlpha = appear * settle;
        const s = p.size * (g > 0 && g < 1 ? 1.25 : 1);
        ctx.drawImage(p.sprite, p.x - s, p.y - s, s * 2, s * 2);
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";

      if (t > GATHER_END - 100) name.classList.add("is-shown");
      if (t > HOLD_END) leave();
      if (!leaving || t < HOLD_END + FADE) raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);
  }

  if (root && html.hasAttribute("data-splash")) start(root);
  else finish();
</script>

<style>
  .splash { display: none; }

  /* 起動画面はライト・ダークにかかわらず暗くする（光の粒を見せるため） */
  :global(html[data-splash]) .splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    background: radial-gradient(120% 90% at 50% 45%, #14121f 0%, #07070b 60%, #000 100%);
    transition: opacity 450ms cubic-bezier(0.4, 0, 0.2, 1);
    /* スクリプトが動かなかったときでも、ずっと画面をふさがないように 3 秒で消す */
    animation: splash-fallback 450ms 3s forwards;
  }
  .splash.is-leaving { opacity: 0; pointer-events: none; }

  .splash__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .splash__name {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0;
    padding-top: 0.5em;
    color: #f5f5f7;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    opacity: 0;
    transform: translateY(6px);
    filter: blur(6px);
    transition:
      opacity 500ms cubic-bezier(0.2, 0, 0, 1),
      transform 500ms cubic-bezier(0.2, 0, 0, 1),
      filter 500ms cubic-bezier(0.2, 0, 0, 1);
  }
  .splash__name.is-shown {
    opacity: 1;
    transform: none;
    filter: none;
  }

  @keyframes splash-fallback {
    to { opacity: 0; visibility: hidden; }
  }
</style>
